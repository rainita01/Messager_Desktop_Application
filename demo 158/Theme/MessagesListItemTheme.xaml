<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
      <Style x:Key="MessagesListViewTheme" TargetType="{x:Type ListView}">
          <Setter Property="Background" Value="WhiteSmoke"></Setter>
          <Setter Property="BorderThickness" Value="0"></Setter>

      </Style>
    <Style x:Key="MessagesListViewItemTheme" TargetType="ListViewItem">
        <Setter Property="HorizontalAlignment" Value="{Binding HorizontalAlignmentMessage}"></Setter> 
     <Setter Property="Template" >
         <Setter.Value>
             <ControlTemplate TargetType="{x:Type ListViewItem}">

                    <StackPanel
                        
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        FlowDirection="{Binding FlowDirectionMessage}">
                        
                        <Ellipse Height="30" Width="30" >
                            <Ellipse.Fill>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Grid Background="White">
                                            <Image Source="{Binding SenderImage}" 
                                                   Stretch="UniformToFill"/>
                                        </Grid>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Ellipse.Fill>
                        </Ellipse>


                        <StackPanel>
                           <StackPanel Orientation="Horizontal">
                               <Label 
                                   Content="{Binding SenderName}"
                                   Foreground="Black"
                                   FontSize="15"
                                   VerticalAlignment="Center"


                               ></Label>
                               <Label  
                                   Content="{Binding SentTime}"
                                   Foreground="LightGray"
                                   FontSize="10"
                                   VerticalAlignment="Bottom"
                               ></Label>
                               
                           </StackPanel>
                            <Border 
                                Margin="4 1 0 0"
                                Background="{Binding BackgroundColorBrush}"
                                Padding="6 4 6 4 "
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                >
                                <TextBox

                                    TextWrapping="Wrap"
                                    MinHeight="25"
                                    MaxHeight="100"
                                    MinWidth="25"
                                    MaxWidth="200"
                                    FontSize="16"
                                    FontFamily="../Fonts/#Dirooz"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    IsReadOnly="True"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Text="{Binding Text}"
                                ></TextBox>
                            </Border>
                            </StackPanel>
                       </StackPanel>
             </ControlTemplate>
         </Setter.Value>
     </Setter>

  <Style.Resources>
      <ControlTemplate x:Key="CustomRow">

                    <Border
                        Margin="35 1 35 0"
            Background="{Binding BackgroundColorBrush}"
                        Padding="6 4 6 4 "
            CornerRadius="10"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
        >
            <TextBox

                TextWrapping="Wrap"
                MinHeight="25"
                MaxHeight="100"
                MinWidth="25"
                MaxWidth="200"
                FontSize="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Background="Transparent"
                IsReadOnly="True"
                BorderThickness="0"
                Cursor="Hand"
                Text="{Binding Text}"
            ></TextBox>
        </Border>
      </ControlTemplate>
  </Style.Resources>
        <Style.Triggers>
            <DataTrigger Binding="{Binding FirstMessage}" Value="False">
                <Setter Property="Template" Value="{StaticResource CustomRow}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>