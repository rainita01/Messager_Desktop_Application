<Window x:Class="demo_158.MVVM.View.ContactProfileVeiw"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo_158.MVVM.View"
        mc:Ignorable="d"
        Title="ProfileView" Height="490" Width="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border 
    Background="#4A7691"
  
    >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"></RowDefinition>
                <RowDefinition Height="3*"></RowDefinition>
                <RowDefinition Height="5*"></RowDefinition>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#142632"
                Height="40" 
                VerticalAlignment="Top"
                CornerRadius="0 0 10 10"
                >
                <Grid>

                    <Button  
                        Style="{StaticResource TopToolsButtonThem}"
                        Width="30"
                        Content="×"
                        Click="ProfileViewExitButton"
                        HorizontalAlignment="Right"

                    ></Button>

                    <Label
                        HorizontalAlignment="Left"
                        Content="Profile"
                        Foreground="Gainsboro"
                        FontSize="14"
                        VerticalAlignment="Center"
                         Margin="10 0 0 10"
                        ></Label>
                </Grid>



            </Border>
            <Border
          CornerRadius="50"
      
         
           Grid.Row="1">

                <Ellipse 
              HorizontalAlignment="Center"
              Width="150"       
              Height="145"
               Stroke="LightCoral"
              
              StrokeDashCap="Round"
              StrokeDashOffset="2"
              StrokeStartLineCap="Flat"
              >
                    <Ellipse.Fill >

                        <VisualBrush  >
                            <VisualBrush.Visual >
                                <Grid Background="White" >
                                    <Image 
                                  Stretch="UniformToFill"
                                  Source="{Binding Image}"></Image>
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Ellipse.Fill>
                </Ellipse>

            </Border>
            <StackPanel
             Margin="10 0 0 0 "
             Grid.Row="2"
             Width="340"
            
             >
                <Label
                 Margin="30 0 0 0"
                 HorizontalAlignment="Left"
                 Content="Username:"
                    Width="250"
                    Foreground="LightGray"
             ></Label>
                <TextBlock
                  Name="Username"
                  Margin="0 0 17 0"
                  Width="250"
                  Foreground="White"
                  Padding="3"
                  Background="#2A4759"
                  Text="{Binding Username}"
                  Height="30"
                  
              ></TextBlock>
                <Label 
                    Margin="30 10 0 0"
                    HorizontalAlignment="Left"
                    Content="Email:"
                    
                    Width="250"
                    Foreground="LightGray"
             ></Label>
                <TextBlock
                    Foreground="White"
                    Background="#2A4759"
                     Name="Email"
                     Padding="3"
                     Margin="0 0 17 0"
                     Width="250"
                     Text="{Binding Email}"
                     Height="30"
                 ></TextBlock>

                <Label Content="Bio:"
                       Margin="30 10 0 0"
                       HorizontalAlignment="Left"
                       Width="250"
                       Foreground="LightGray"
             ></Label>
                <TextBlock
                     Foreground="White"
                     Name="Bio"
                     Margin="0 0 17 0"
                     Width="250"
                     Padding="3"
                     Background="#2A4759"
                     Text="{Binding Bio}"
                     Height="70"
                 ></TextBlock>
            </StackPanel>
        </Grid>

    </Border>
</Window>
