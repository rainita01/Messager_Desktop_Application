<UserControl x:Class="demo_158.MVVM.View.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:demo_158.MVVM.View"
             xmlns:vmc="clr-namespace:demo_158.MVVM.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="450"
             Loaded="LoginView_OnLoaded"

             >
    <Border 
    
      Background="Transparent" 
      BorderThickness="0" Margin="2,0,-2,0">

      <StackPanel Margin="10">
          <TextBox Margin="0 0 0  20" 
                   Height="30"
                   Width="200"
                   Name="Username"
                   Style="{StaticResource LoginSignTextBoxTheme}"
                   Text="{Binding Username}"
                   TabIndex="1"
                   VerticalContentAlignment="Center"
                   ></TextBox>
         <Grid>

             <PasswordBox 
                 Width="200"
                 Height="30"
                 Name="Password"
                 PasswordChanged="Password_OnPasswordChanged"
                 TabIndex="2" CaretBrush="White"
                 
                 
             ></PasswordBox>
                <TextBlock Foreground="#EEEEEE"
                        Text="Password"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Margin="0 0 122 0"
                        Name="PasswordTextBlock"
                        IsHitTestVisible="False"
                        Visibility="{Binding PasswordTextBlockVisibility}"
                        ></TextBlock>
            </Grid>
          
          
          <TextBlock HorizontalAlignment="Center"

                     Margin="0 10 100 10" 
                     Text="ForgetPassword?"
                     Foreground="White"
                     ></TextBlock>
            <Button
              
              
              Width="200"
                  Height="30"
                  Content="Log in"
                  Command="{Binding LoginCommand}"
                  TabIndex="3"
                  

                  Style="{StaticResource LoginButtonTheme}"
                  Name="LogInButton"
                  >
                <Button.InputBindings>
                    <KeyBinding
                        Key="Enter"
                        Command="{Binding LoginCommand}"></KeyBinding>
                </Button.InputBindings>
            </Button>
          

</StackPanel>
  </Border>
</UserControl>
