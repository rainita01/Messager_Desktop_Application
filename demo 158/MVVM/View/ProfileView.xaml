<Window x:Class="demo_158.MVVM.View.ProfileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo_158.MVVM.View"
        mc:Ignorable="d"
        Title="ProfileView" Height="490" Width="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        
        >
<Border 
    Background="#4A7691"
  
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="5*"></RowDefinition>
        </Grid.RowDefinitions>
        
            <Border
                Grid.Row="0"
                Background="#142632"
                Height="40" 
                VerticalAlignment="Top"
                CornerRadius="0 0 10 10"
                >
                <Grid>

                    <Button  
                        Style="{StaticResource TopToolsButtonThem}"
                        Width="30"
                        Content="×"
                        Click="ProfileViewExitButton"
                        HorizontalAlignment="Right"

                    ></Button>

                    <Label
                        HorizontalAlignment="Left"
                        Content="Profile"
                        Foreground="Gainsboro"
                        FontSize="14"
                        VerticalAlignment="Center"
                         Margin="10 0 0 10"
                        ></Label>
                </Grid>
            
                    
               
            </Border>
      <Border
          CornerRadius="50"
      
         
           Grid.Row="1">
           <StackPanel
               Orientation="Horizontal"
               HorizontalAlignment="Center"
               >
               <Ellipse 
                   HorizontalAlignment="Center"
                   Width="150"       
                   Height="145"
                   Stroke="LightGreen"
      
                   StrokeDashCap="Round"
                   StrokeDashOffset="2"
                   StrokeStartLineCap="Flat"
               >
                   <Ellipse.Fill >

                       <VisualBrush  >
                           <VisualBrush.Visual >
                               <Grid Background="White" >
                                   <Image 
                                       Stretch="UniformToFill"
                                       Name="ImageP"
                                       Source="{Binding Image}"
                                       ></Image>
                               </Grid>
                           </VisualBrush.Visual>
                       </VisualBrush>
                   </Ellipse.Fill>
               </Ellipse>
               <Button Height="20"
                       Width="20"
                       Margin="0 0 0 110"
                       Content="c"
                       Command="{Binding ChangeProfileImage}"
                       ></Button>
                </StackPanel>
        

            </Border>
         <StackPanel
             Margin="10 0 0 0 "
             Grid.Row="2"
             Width="340"
            
             >
             <Label
                 Margin="30 0 0 0"
                 HorizontalAlignment="Left"
                 Content="Username:"
                    Width="250"
                    Foreground="LightGray"
             ></Label>
              <TextBox
                  VerticalContentAlignment="Center"
                  Name="Username"
                  IsReadOnly="True"
                  Margin="0 0 17 0"
                  Width="250"
                  Text="{Binding MyUserInfo.Username}"
                  Height="30"
                  Style="{StaticResource LoginSignTextBoxTheme}"
              ></TextBox>
             <Label 
                 Margin="30 10 0 0"
                 HorizontalAlignment="Left"
                 Content="Email:"
                    
                    Width="250"
                    Foreground="LightGray"
             ></Label>
                 <TextBox
                     VerticalContentAlignment="Center"
                     TextChanged="Email_OnTextChanged"
                     Name="Email"
                     Margin="0 0 17 0"
                     Width="250"
                     Text="{Binding MyUserInfo.Email}"
                     Height="30"
                     Style="{StaticResource LoginSignTextBoxTheme}"
                 ></TextBox>
            
                <Label Content="Bio:"
                      
                       Margin="30 10 0 0"
                       HorizontalAlignment="Left"
                    Width="250"
                    Foreground="LightGray"
             ></Label>
                 <TextBox
                     VerticalContentAlignment="Top"
                     TextChanged="Bio_OnTextChanged"
                     Name="Bio"
                     Margin="0 0 17 0"
                     Width="250"
                     Text="{Binding MyUserInfo.BioCaption}"
                     Height="70"
                     Style="{StaticResource LoginSignTextBoxTheme}"
                 ></TextBox>
             <Button
                 
                 Height="35"
                 Width="60"
                 Margin="5"
                 Name="SaveButton"
                 Visibility="Hidden"
                 Content="Save"
                 Command="{Binding SaveChanges}"
                 Style="{DynamicResource LoginButtonTheme}"
                     ></Button>
            </StackPanel>
    </Grid>

    </Border>
</Window>
