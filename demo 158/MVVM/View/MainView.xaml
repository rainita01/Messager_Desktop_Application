<Window x:Class="demo_158.MVVM.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo_158.MVVM.View"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        WindowState="Normal"
        Background="Transparent"
        Title="MainView" Height="700" Width="800">
    <Window.Resources>
        <CollectionViewSource 
            x:Key="ListConversations"
            Source="Conversations"
            >
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="DateTime" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>

        </CollectionViewSource>
    </Window.Resources>
    <Border Background="#4A7691" 
            
            CornerRadius="5 5 5 5 "
    >

    <DockPanel >
        <Border 
            
            CornerRadius="5 5 5 5 "
            DockPanel.Dock="Top"
            Height="30"
            Background="#2A4759"
            BorderThickness="0"

        >
            <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding MoveAndDrugCommand }"></MouseBinding>
            </Border.InputBindings>
         <Grid>
             <Grid.ColumnDefinitions>
                 <ColumnDefinition></ColumnDefinition>
                 <ColumnDefinition></ColumnDefinition>
                 <ColumnDefinition></ColumnDefinition>
             </Grid.ColumnDefinitions>
             <StackPanel Grid.Column="2" HorizontalAlignment="Right" 
                         Orientation="Horizontal">

                 <Button  
                     Style="{StaticResource TopToolsButtonThem}"
                     Width="30"
                     Content="-"
                     Click="TopHideButtonClick"
           
                 ></Button>
                 <Button  
                     Style="{StaticResource TopToolsButtonThem}"
                     Width="30"
                     Content="□"
                     Click="NormalizeMaximizeWindowClick"
       
                 ></Button>
                 <Button  
                     Style="{StaticResource TopToolsButtonThem}"
                     Width="30"
                     Content="×"
                     Click="CloseTheAppClick"
                 ></Button>

             </StackPanel>
             <Label Grid.Column="0"
                    Margin="20 0 0 0"
                    Content="AMessager"
                    HorizontalAlignment="Left"
                    Foreground="Gainsboro"
             ></Label>
                    <Label Grid.Column="1"
                       Content="Try:1.0.0.1"
                       HorizontalAlignment="Center"
                       Foreground="Gainsboro"
                       ></Label>

                </Grid>

        </Border>

          <Grid>
           <Grid.ColumnDefinitions>
             
               <ColumnDefinition Width="Auto"></ColumnDefinition>
               <ColumnDefinition Width="5*"></ColumnDefinition>
           </Grid.ColumnDefinitions>
        <Grid Grid.Column="0"  >


            <StackPanel
           Orientation="Horizontal"
           HorizontalAlignment="Left"
           Grid.Column="0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Border
                                 Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Background="#4A7691  "
                                 Margin="0 20 0 0 "
                                 Width="35">
                            <StackPanel >
                                <Button
                                    Margin="0 0 0 25"
                                    Foreground="White"
                                    FontSize="16"
                                    Content="{Binding UserModelFromServer.Username}"
                                    Style="{StaticResource ProfileButton}"
                                    Command="{Binding OpenProfileCommand}"
                      >

                                </Button>
                                <RadioButton 
                                   FontSize="16"
                                   Foreground="White"
                                   Content="💬  All Chats"
                                   IsChecked="True"
                                   Style="{StaticResource RadioButtonStyle}"

                      ></RadioButton>

                            </StackPanel>
                            <Border.Style>
                                <Style>
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Border.MouseEnter">
                                            <EventTrigger.Actions>
                                                <BeginStoryboard >
                                                    <Storyboard>
                                                        <DoubleAnimation 
                                                           Storyboard.TargetProperty="(Border.Width)"
                                                           To="120"
                                                           Duration="0:0:.1"
                                                           ></DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger.Actions>
                                        </EventTrigger>
                                        <EventTrigger  RoutedEvent="Border.MouseLeave">
                                            <EventTrigger.Actions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(Border.Width)"
                                           To="35"
                                           Duration="0:0:.1"
                                                     />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger.Actions>

                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>

                                  </Border.Style>
                            </Border>
                            <Border
                                Grid.Row="2"
                                Margin="5 5 0 10"
                                HorizontalAlignment="Left"
                                >
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Fill="{Binding CycleFillerBrush}"
                                    Stroke="White" 
                                    StrokeThickness="1"/>
                            </Border>
                   </Grid>
                     

                        <Border
                  CornerRadius="20"
                  Margin="5"
                  Background="WhiteSmoke ">

                            <DockPanel >
                                <TextBox
                          Margin="10 15 10 10"
                          Style="{StaticResource SearchTextBox}"
   
                          DockPanel.Dock="Top" ></TextBox>

                                <Border
                                    Margin="0 2 0 10"
                          Background="Transparent"
                          CornerRadius="0 0 20 20"
                      >

                                    <ListView
                                        SelectedItem="{Binding ConversationViewModel,Mode=TwoWay}"
                                        Name="ContactsList"
                                        ItemsSource="{Binding Conversations}"
                                        Style="{StaticResource ContactsListTheme}"
                                        ItemContainerStyle="{StaticResource ContactsListItemTheme}"
                          >


                                    </ListView>
                                </Border>
                            </DockPanel>
                        </Border>


                    </StackPanel>

                </Grid>
              <Border 
                  Margin="5 5 10 5"
                  CornerRadius="20"
                  Background="WhiteSmoke"
                  Grid.Column="1"
                      >
                 <UserControl
                     Content="{Binding CurrentView}"
                     ></UserControl>

              </Border>
            </Grid>
        

    </DockPanel>
    </Border>
    
</Window>
